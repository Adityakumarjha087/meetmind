# ---------------------------------------------------------------------------
# MeetMind configuration. Copy to .env and adjust. Every value has a safe
# offline default: with no keys at all the full pipeline runs locally.
# ---------------------------------------------------------------------------

# --- core ---
ENVIRONMENT=development            # development | test | production (production enforces secrets)
LOG_LEVEL=INFO
LOG_JSON=true
JWT_SECRET=replace-with-64-random-chars-e.g.-openssl-rand-hex-32   # >= 32 chars, required in production
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
REFRESH_COOKIE_SECURE=false        # set true behind HTTPS
CORS_ORIGINS=http://localhost:20700
FRONTEND_URL=http://localhost:20700
PUBLIC_API_URL=http://localhost:20701

# --- data stores (docker compose wires these automatically) ---
POSTGRES_PASSWORD=meetmind
DATABASE_URL=postgresql+psycopg://meetmind:meetmind@localhost:20710/meetmind
REDIS_URL=redis://localhost:20711/0
STORAGE_BACKEND=s3                 # s3 (MinIO/AWS) | local
S3_ENDPOINT_URL=http://localhost:20712
S3_BUCKET=meetmind-audio
MINIO_ROOT_USER=meetmind
MINIO_ROOT_PASSWORD=meetmind-minio-secret
MAX_UPLOAD_MB=500

# --- speech (pluggable; defaults need no downloads or keys) ---
STT_BACKEND=sidecar                # sidecar (offline fixture/transcript) | faster_whisper | openai_whisper
WHISPER_MODEL_SIZE=base            # faster-whisper: tiny|base|small|medium|large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
DIARIZER_BACKEND=spectral          # spectral (offline) | pyannote (needs HF_TOKEN)
HF_TOKEN=
INSTALL_ML=false                   # docker build arg: true installs faster-whisper + pyannote

# --- LLM (pluggable) ---
LLM_PROVIDER=offline               # offline | anthropic | openai | gemini | ollama
LLM_MODEL=                         # optional override of the provider default below
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
LLM_TIMEOUT_S=120
LLM_FALLBACK_OFFLINE=true          # degrade to offline notes if the provider fails
LONG_MEETING_THRESHOLD_S=3600      # map-reduce summarisation above this duration
MAP_CHUNK_S=600

# --- embeddings / RAG ---
EMBEDDING_BACKEND=hashing          # hashing (offline) | openai
EMBEDDING_DIM=384
RAG_TOP_K=6

# --- integrations ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:20701/api/v1/auth/google/callback
SLACK_ALLOWED_HOSTS=hooks.slack.com

# --- abuse protection ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=240
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=20

# --- pipeline robustness ---
PIPELINE_STALE_AFTER_S=3600        # reclaim 'processing' jobs with no heartbeat for this long
SHARE_LINK_DEFAULT_DAYS=30

# --- demo ---
SEED_DEMO=true                     # seed demo@meetmind.dev / meetmind-demo on first start
